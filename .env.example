# ---------------------------------------------------------------------------
# Social Autopilot - environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (SQLite — desktop build) ---
# The desktop app stores its database in the OS user-data directory automatically
# (see electron/db.cjs); you don't need to set this for the packaged app.
# For local web/dev runs, point it at a local SQLite file:
DATABASE_URL="file:./prisma/dev.db"

# --- Scheduler ---
# The desktop build runs an in-process scheduler inside the Next.js server (no
# Redis/BullMQ). Set to "0" only if you run scheduling as a separate
# `npm run worker` process against the same database.
RUN_INPROCESS_SCHEDULER="1"

# --- App ---
APP_BASE_URL="http://localhost:3000"
# Timezone used for the "morning review" planning window (IANA name).
REVIEW_TIMEZONE="Europe/Oslo"
# Local hour (0-23) at which the daily review digest is assembled.
REVIEW_HOUR="7"
# Comma-separated local hours to drip approved posts across, e.g. 9,13,17.
POSTING_SLOT_HOURS="9,13,17"

# ---------------------------------------------------------------------------
# LLM provider (provider-agnostic). Set LLM_PROVIDER to one of: mock | openai | anthropic
# `mock` requires no API key and is used by `npm run verify:core`.
# ---------------------------------------------------------------------------
LLM_PROVIDER="mock"
LLM_MODEL=""                      # optional override, e.g. gpt-4o-mini or claude-3-5-sonnet-latest

OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"

# ---------------------------------------------------------------------------
# Social platform OAuth apps. Fill in once each app is approved by the platform.
# Redirect URI convention: {APP_BASE_URL}/api/oauth/{platform}/callback
# ---------------------------------------------------------------------------

# LinkedIn (Marketing Developer Platform / Community Management API)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Meta (Facebook Pages + Instagram Graph API). One app covers both.
META_APP_ID=""
META_APP_SECRET=""
# Optional: which Facebook Page to publish to (Page id). If unset, the first
# Page the connecting user manages is used. For Instagram, the first IG-linked
# Page is used.
META_PAGE_ID=""

# X / Twitter (API v2, OAuth 2.0)
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# Token encryption key (32-byte base64). Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""
