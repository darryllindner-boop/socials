# ---------------------------------------------------------------------------
# Social Autopilot - environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) ---
# Local dev example: postgresql://postgres:postgres@localhost:5432/social_autopilot
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/social_autopilot?schema=public"

# --- Redis (BullMQ queue/scheduler) ---
REDIS_URL="redis://localhost:6379"

# --- App ---
APP_BASE_URL="http://localhost:3000"
# Timezone used for the "morning review" planning window (IANA name).
REVIEW_TIMEZONE="Europe/Oslo"
# Local hour (0-23) at which the daily review digest is assembled.
REVIEW_HOUR="7"

# ---------------------------------------------------------------------------
# LLM provider (provider-agnostic). Set LLM_PROVIDER to one of: mock | openai | anthropic
# `mock` requires no API key and is used by `npm run verify:core`.
# ---------------------------------------------------------------------------
LLM_PROVIDER="mock"
LLM_MODEL=""                      # optional override, e.g. gpt-4o-mini or claude-3-5-sonnet-latest

OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"

# ---------------------------------------------------------------------------
# Social platform OAuth apps. Fill in once each app is approved by the platform.
# Redirect URI convention: {APP_BASE_URL}/api/oauth/{platform}/callback
# ---------------------------------------------------------------------------

# LinkedIn (Marketing Developer Platform / Community Management API)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Meta (Facebook Pages + Instagram Graph API). One app covers both.
META_APP_ID=""
META_APP_SECRET=""

# X / Twitter (API v2, OAuth 2.0)
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# Token encryption key (32-byte base64). Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""
